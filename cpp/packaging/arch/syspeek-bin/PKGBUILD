# Maintainer: Syspeek <noreply@example.com>
# Prebuilt binary for AUR (package name: syspeek-bin). Repackages the
# official portable bundle (Qt 6 is bundled, no Qt needed on the host).
# Publish: bash cpp/packaging/arch/publish-aur.sh syspeek-bin
pkgname=syspeek-bin
pkgver=0.5.0
pkgrel=1
pkgdesc="Compact always-on-top HUD for focused-process and infra status (prebuilt)"
arch=('x86_64')
url="https://github.com/codeafridi/Syspeek"
license=('MIT')
depends=('glibc' 'hicolor-icon-theme')
optdepends=('xdotool: focused-window detection on X11/XWayland sessions'
            'docker: Docker container health badges'
            'kubectl: Kubernetes workload health badges')
provides=('syspeek')
conflicts=('syspeek')
# Prebuilt binaries must not be stripped (they ship their own bundled Qt).
options=('!strip' '!debug')
source=("syspeek-portable-$pkgver.tar.gz::https://github.com/codeafridi/Syspeek/releases/download/v$pkgver/syspeek-portable.tar.gz"
        "syspeek.svg::https://raw.githubusercontent.com/codeafridi/Syspeek/v$pkgver/cpp/packaging/icons/syspeek.svg"
        "LICENSE-$pkgver::https://raw.githubusercontent.com/codeafridi/Syspeek/v$pkgver/LICENSE")
# Checksums refreshed for v0.5.0 (publish .SRCINFO alongside). To refresh
# locally on Arch: `updpkgsums && makepkg --printsrcinfo > .SRCINFO`.
sha256sums=('084d56d365a5747c46a8bcf048690a10aa1870da659635abe62a158e983a2bc5'
            'baf84f64c63c501ac8f22e2f2853152b4b6ddcbb18b06d24e08ccc60dbc4cc16'
            'c0768673b1f931dbac895284d725a7e9a55c1fbe9328df52d9a800fa49aec55c')

package() {
    install -dm0755 "$pkgdir/opt/syspeek"
    # Bundle layout: syspeek, lib/, plugins/, run.sh, bridge/, README.md.
    # run.sh sets LD_LIBRARY_PATH/QT_PLUGIN_PATH relative to itself.
    tar xzf "$srcdir/syspeek-portable-$pkgver.tar.gz" -C "$pkgdir/opt/syspeek"
    chmod +x "$pkgdir/opt/syspeek/run.sh" "$pkgdir/opt/syspeek/syspeek"
    install -dm0755 "$pkgdir/usr/bin"
    ln -s /opt/syspeek/run.sh "$pkgdir/usr/bin/syspeek"
    cat > syspeek.service <<'EOF'
[Unit]
Description=Syspeek
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/syspeek
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
EOF
    install -Dm0644 syspeek.service \
        "$pkgdir/usr/lib/systemd/user/syspeek.service"
    cat > syspeek.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Syspeek
Comment=Compact on-screen focused-process monitor
Exec=/usr/bin/syspeek
Icon=syspeek
Terminal=false
Categories=Utility;System;Monitor;
EOF
    install -Dm0644 syspeek.desktop \
        "$pkgdir/usr/share/applications/syspeek.desktop"
    install -Dm0644 "$srcdir/syspeek.svg" \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/syspeek.svg"
    install -Dm0644 "$srcdir/LICENSE-$pkgver" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm0644 "$pkgdir/opt/syspeek/README.md" \
        "$pkgdir/usr/share/doc/$pkgname/README.md"
}
